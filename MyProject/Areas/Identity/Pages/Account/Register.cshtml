using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Project.Data;
using Project.Models;

namespace Project.Controllers
{
    [Authorize(Roles = "NationalBankAdmin")]
    public class BankController : Controller
    {
        private readonly ApplicationDbContext _db;

        public BankController(ApplicationDbContext db)
        {
            _db = db;
        }

        // GET: /Bank/Index
        public IActionResult Index()
        {
            var banks = _db.Banks.OrderByDescending(b => b.CreatedAt).ToList();
            return View(banks);
        }

        // GET: /Bank/Create
        public IActionResult Create()
        {
            return View();
        }

        // POST: /Bank/Create
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult>
    Create(Bank bank)
    {
    if (ModelState.IsValid)
    {
    // Ensure default values are set
    bank.CreatedAt = DateTime.UtcNow;
    bank.IsApproved = Bank.ApprovalStatus.Pending;

    _db.Banks.Add(bank);
    await _db.SaveChangesAsync();
    TempData["Success"] = $"Bank '{bank.Name}' created successfully.";
    return RedirectToAction(nameof(Index));
    }
    return View(bank);
    }

    // GET: /Bank/Details/5
    public async Task<IActionResult>
        Details(int? id)
        {
        if (id == null)
        {
        return NotFound();
        }

        var bank = await _db.Banks
        .FirstOrDefaultAsync(m => m.BankId == id);

        if (bank == null)
        {
        return NotFound();
        }

        return View(bank);
        }

        // GET: /Bank/Edit/5
        public async Task<IActionResult>
            Edit(int? id)
            {
            if (id == null)
            {
            return NotFound();
            }

            var bank = await _db.Banks.FindAsync(id);
            if (bank == null)
            {
            return NotFound();
            }
            return View(bank);
            }

            // POST: /Bank/Edit/5
            [HttpPost]
            [ValidateAntiForgeryToken]
            public async Task<IActionResult>
                Edit(int id, Bank bank)
                {
                if (id != bank.BankId)
                {
                return NotFound();
                }

                if (ModelState.IsValid)
                {
                try
                {
                // Preserve the creation date and approval status if not explicitly updated via the form
                var existingBank = await _db.Banks.AsNoTracking().FirstOrDefaultAsync(b => b.BankId == id);
                if (existingBank != null)
                {
                bank.CreatedAt = existingBank.CreatedAt; // Preserve the original creation date
                }

                _db.Banks.Update(bank);
                await _db.SaveChangesAsync();
                }
                catch (DbUpdateConcurrencyException)
                {
                if (!BankExists(bank.BankId))
                {
                return NotFound();
                }
                else
                {
                throw;
                }
                }
                TempData["Success"] = $"Bank '{bank.Name}' updated successfully.";
                return RedirectToAction(nameof(Index));
                }
                return View(bank);
                }

                // Helper method for Edit POST
                private bool BankExists(int id)
                {
                return _db.Banks.Any(e => e.BankId == id);
                }
                }
                }
