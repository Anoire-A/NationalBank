@model Project.Models.Bank

@{
    ViewData["Title"] = "Delete Bank";
}

<h1>Delete Bank</h1>

<h3>Are you sure you want to delete this bank?</h3>
<div>
    <h4>This action cannot be undone.</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RegistrationNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RegistrationNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-2">
            Approval Status
        </dt>
        <dd class="col-sm-10">
            @if (Model.IsApproved)
            {
                <span class="badge bg-success">Approved</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        @if (Model.AssociatedUser != null)
        {
            <dt class="col-sm-2">
                Associated User
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.AssociatedUser.Email)
            </dd>
        }
    </dl>

    <div class="alert alert-warning" role="alert">
        <strong>Warning:</strong> This will permanently delete:
        <ul class="mb-0 mt-2">
            <li>The bank record</li>
            @if (Model.AssociatedUser != null)
            {
                <li>The associated user account (@Model.AssociatedUser.Email)</li>
            }
            <li>All associated financial reports</li>
        </ul>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <div class="mt-4">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

