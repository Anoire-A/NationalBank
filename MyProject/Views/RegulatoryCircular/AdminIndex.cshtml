@model IEnumerable<Project.Models.RegulatoryCircular>

@{
    ViewData["Title"] = "Regulatory Circulars";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Regulatory Circulars</h1>
        <p class="text-muted mb-0">Publish and manage notices sent to commercial banks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus-circle me-1"></i> New Circular</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No circulars have been published yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Effective Date</th>
                    <th>Published</th>
                    <th>Attachment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Title</strong><br />
                            <small class="text-muted">@item.Summary</small>
                        </td>
                        <td>@(item.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@item.PublishedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.AttachmentPath))
                            {
                                <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-file-download me-1"></i> Download
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No file</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
