@model IEnumerable<Project.Models.RegulatoryCircular>

@{
    ViewData["Title"] = "Notice Board";
}

<h1>Notice Board</h1>
<p class="text-muted">Latest directives from the National Bank.</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No circulars available at this time.</div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">@item.Title</div>
                    <div class="text-muted small">
                        Published @item.PublishedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        @if (item.EffectiveDate.HasValue)
                        {
                            <span class="ms-2">| Effective @item.EffectiveDate.Value.ToString("yyyy-MM-dd")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Summary))
                    {
                        <p class="mb-1">@item.Summary</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Body))
                    {
                        <p class="mb-1 text-muted">@item.Body</p>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(item.AttachmentPath))
                {
                    <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-download me-1"></i> PDF
                    </a>
                }
            </div>
        }
    </div>
}
